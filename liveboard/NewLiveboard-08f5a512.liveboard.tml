    - visualization_id: Group_1
      x: 0
      "y": 0
      height: 9
      width: 12
    - visualization_id: Group_2
      x: 0
      "y": 9
      height: 18
      width: 12
    group_layouts:
    - id: Group_1
      tiles:
      - visualization_id: Viz_1
        x: 0
        "y": 0
        height: 8
        width: 4
      - visualization_id: Viz_2
        x: 4
        "y": 0
        height: 8
        width: 8
